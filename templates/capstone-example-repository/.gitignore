# Do not commit large or sensitive data by default.
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Native BI files can be large and may include embedded data.
*.pbix
*.pbit
*.twb
*.twbx
